{
  "name": "@local/dsh-ssh-integration",
  "description": "SSH remote execution integration for the DeepSeek Harness: ssh-remote settings, credentials, host-key trust, execution-world binding and a fail-closed execution gate",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./types": "./src/types.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@local/dsh-ssh-runtime": "0.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
