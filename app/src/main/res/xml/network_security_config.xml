<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView talks to loopback only; cleartext is permitted there and
     nowhere else. Model API egress happens in the dsh process (direct from
     the phone with the user's own key), not in this WebView. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
